rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Settings branding images — any authenticated user can read/write
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth();
    }

    // School logos
    match /schools/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Admission form uploads (public read, auth write)
    match /admissions/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Default: authenticated users only
    match /{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
  }
}
